+#include <stdio.h>
+#include <stdlib.h>
+#include <glib.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "OMX_Index.h"
+#include "OMX_CoreExt.h"
+#include "OMX_Component.h"
+#include "omx_base_source.h"
+#include "OMX_VendorCommon.h"
+#include "omx_videobufreader_component.h"
+#include "omx_base_video_port.h"
+
+#define TDBG(fmt, args...) \
+			do { \
+				struct timespec _now;    \
+				struct tm _tm;	\
+				clock_gettime(CLOCK_REALTIME, &_now); 	\
+				localtime_r(&_now.tv_sec, &_tm);	 \
+				printf("[%04d-%02d-%02d %02d:%02d:%02d.%03ld][%s:%d]" fmt "\n", _tm.tm_year + 1900, _tm.tm_mon+1, _tm.tm_mday, _tm.tm_hour, _tm.tm_min, _tm.tm_sec, _now.tv_nsec/1000000, __FUNCTION__, __LINE__, ## args); \
+			}while(0)
+#define DBG_INFO(fmt, args...) TDBG(fmt, ##args)
+#define DBG_ERR(fmt, args...) TDBG(fmt, ##args)
+#define DBG_TRACE(fmt, args...)
+
+/**
+ * @brief Enumeration for the possible states of a reader.
+ */
+typedef enum
+{
+	videobufreader_State_Stop,		/** The reader is in the stop state. */
+	videobufreader_State_Start		/** The reader is in the start state. */
+} videobufreader_State_E;
+
+/**
+ * @brief Structure representing a mapped memory region.
+ *
+ * This structure holds the base address and size of a memory region
+ * mapped using mmap(), typically used for accessing physical memory.
+ */
+typedef struct
+{
+	void* base;		/**< Base virtual address of the mapped memory. */
+	size_t size;	/**< Size in bytes of the mapped memory region. */
+} MappedMemInfo;
+
+/**
+ * @brief Structure containing private context data for the buffer reader component.
+ *
+ * This structure holds internal runtime data such as state flags, buffer queues,
+ * format/resolution settings, and memory mapping information used by the OMX buffer reader component.
+ */
+typedef struct
+{
+	videobufreader_State_E eState;  		/**< Current running state of the component (Start/Stop). */
+	OMX_BOOL reachEos;  					/**< Flag indicating whether End Of Stream (EOS) has been reached. */
+	tsem_t tSemConfig;  					/**< Semaphore used for synchronizing configuration access. */
+	GQueue *emptyBufferQueue;  				/**< Queue containing empty OMX_BUFFERHEADERTYPE structures. */
+	GQueue *outputBufferQueue; 				/**< Queue containing filled buffers waiting to be processed. */
+	GQueue *allocatedBuffers;				/**< Queue containing allocated buffers */
+	OMX_COLOR_FORMATTYPE bufColorFormat;  	/**< Color format of the input frames (e.g., RGB888, NV12). */
+	OMX_VendorConfig_Common_Resolution_T bufResoution;  /**< Resolution and stride of input frames. */
+} videobufreader_PrivateData_T;
+
+/**
+ * @brief Constructs the OMX component instance.
+ *
+ * This function constructs the OMX component instance and initializes its parameters.
+ *
+ * @param[in] pComp Pointer to the OMX component instance.
+ *
+ * @return OMX_ERRORTYPE Returns an error code indicating the status of the operation.
+ */
+static OMX_ERRORTYPE omx_videobufreader_Constructor(OMX_COMPONENTTYPE *pComp, OMX_STRING strCompontName);
+
+/**
+ * @brief Constructor function for initializing the private data of the reader component.
+ *
+ * This function constructs the OMX component instance and initializes its parameters.
+ *
+ * @param[in] pComp Pointer to the OMX component instance.
+ * @param[in] ptPrivate Pointer to the omx_videobufreader_Private_T structure containing the private data of the reader component.
+ *
+ * @return OMX_ERRORTYPE Returns an error code indicating the status of the operation.
+ */
+static OMX_ERRORTYPE omx_videobufreader_Constructor_PrivateData(OMX_COMPONENTTYPE *pComp, omx_videobufreader_Private_T *ptPrivate);
+
+/**
+ * @brief Destructs the OMX component instance.
+ *
+ * This function destructs the OMX component instance and frees any resources used by it.
+ *
+ * @param[in] pComp Pointer to the OMX component instance.
+ *
+ * @return OMX_ERRORTYPE Returns an error code indicating the status of the operation.
+ */
+static OMX_ERRORTYPE omx_videobufreader_Destructor(OMX_COMPONENTTYPE *pComp);
+
+/**
+ * @brief Sets configuration parameters for the OMX component.
+ *
+ * This function sets configuration parameters for the OMX component, based on the specified configuration type and value.
+ *
+ * @param[in] hFx Handle to the OMX component instance.
+ * @param[in] eConfig The configuration parameter to set.
+ * @param[in] pvConfig Pointer to the configuration value.
+ *
+ * @return OMX_ERRORTYPE Returns an error code indicating the status of the operation.
+ */
+static OMX_ERRORTYPE omx_videobufreader_SetConfig(OMX_HANDLETYPE hFx, OMX_INDEXTYPE eConfig, void *pvConfig);
+
+/**
+ * @brief Sets configuration parameters for the reader component related to input.
+ *
+ * @param[in,out] ptPrivateData A pointer to the reader private data structure.
+ * @param[in] eConfig The type of configuration parameter to set.
+ * @param[in] pvConfig A void pointer to the value of the configuration parameter to set.
+ *
+ * @return OMX_ERRORTYPE Returns an error code indicating the status of the operation.
+ */
+static OMX_ERRORTYPE omx_videobufreader_SetConfig_videobufreader(OMX_HANDLETYPE hFx, OMX_INDEXTYPE eConfig, void *pvConfig);
+
+/**
+ * @brief Retrieves configuration parameters for the OMX component.
+ *
+ * This function retrieves configuration parameters for the OMX component, based on the specified configuration type and value.
+ *
+ * @param[in] hFx Handle to the OMX component instance.
+ * @param[in] eConfig The configuration parameter to retrieve.
+ * @param[out] pvConfig Pointer to the buffer to store the configuration value.
+ *
+ * @return OMX_ERRORTYPE Returns an error code indicating the status of the operation.
+ */
+static OMX_ERRORTYPE omx_videobufreader_GetConfig(OMX_HANDLETYPE hFx, OMX_INDEXTYPE eConfig, void *pvConfig);
+
+/**
+ * @brief Callback function for buffer management events from the component.
+ *
+ * This function is called by the OMX component when it needs to inform the application about a buffer management event.
+ *
+ * @param[in] pComp Pointer to the OMX component instance.
+ * @param[in] ptOutputBufferHeader Pointer to the output buffer header.
+ *
+ * @return None.
+ */
+static void omx_videobufreader_BufferMgmtCallback(OMX_COMPONENTTYPE *pComp, OMX_BUFFERHEADERTYPE *ptOutputBufferHeader);
+
+/**
+ * @brief Handles state transitions for the OMX component.
+ *
+ * This function handles state transitions for the OMX component, moving it from its current state to the specified destination state.
+ *
+ * @param[in] pComp Pointer to the OMX component instance.
+ * @param[in] eDestState The destination state.
+ *
+ * @return OMX_ERRORTYPE Returns an error code indicating the status of the operation.
+ */
+static OMX_ERRORTYPE omx_videobufreader_DoStateSet(OMX_COMPONENTTYPE *pComp, OMX_STATETYPE eDestState);
+
+static OMX_ERRORTYPE omx_videobufreader_Constructor(OMX_COMPONENTTYPE *pComp, OMX_STRING strCompontName)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	omx_videobufreader_Private_T *ptPrivate;
+
+	ptPrivate = (omx_videobufreader_Private_T *)g_malloc0(sizeof(omx_videobufreader_Private_T));
+
+	if(ptPrivate == NULL)
+	{
+		eError = OMX_ErrorInsufficientResources;
+	}
+	else
+	{
+		pComp->pComponentPrivate = (void *)ptPrivate;
+
+		eError = omx_base_source_Constructor(pComp, strCompontName);
+
+		if(eError != OMX_ErrorNone)
+		{
+			DBG_ERR("Failed to omx_base_source_Constructor(%p, %s) -> 0x%x\n", pComp, strCompontName, eError);
+		}
+		else
+		{
+			ptPrivate->sPortTypesParam[0].nStartPortNumber = 0;
+			ptPrivate->sPortTypesParam[0].nPorts = 1;
+
+			ptPrivate->ports = (omx_base_PortType **)g_malloc0(ptPrivate->sPortTypesParam[0].nPorts * sizeof(omx_base_PortType *));
+
+			if(ptPrivate->ports == NULL)
+			{
+				eError = OMX_ErrorInsufficientResources;
+			}
+			else
+			{
+				pComp->SetConfig = omx_videobufreader_SetConfig;
+				pComp->GetConfig = omx_videobufreader_GetConfig;
+				ptPrivate->BufferMgmtCallback 	= omx_videobufreader_BufferMgmtCallback;
+				ptPrivate->DoStateSet			= omx_videobufreader_DoStateSet;
+				ptPrivate->destructor 			= omx_videobufreader_Destructor;
+
+				eError = omx_videobufreader_Constructor_PrivateData(pComp, ptPrivate);
+			}
+		}
+
+		if (eError != OMX_ErrorNone)
+		{
+			(void)omx_videobufreader_Destructor(pComp);
+			g_free(ptPrivate);
+		}
+	}
+
+	return eError;
+}
+
+static OMX_ERRORTYPE omx_videobufreader_Constructor_PrivateData(OMX_COMPONENTTYPE *pComp, omx_videobufreader_Private_T *ptPrivate)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	videobufreader_PrivateData_T *ptPrivateData;
+
+	ptPrivate->pvPrivateData = (void *)g_malloc0(sizeof(videobufreader_PrivateData_T));
+
+	if(ptPrivate->pvPrivateData == NULL)
+	{
+		eError = OMX_ErrorInsufficientResources;
+	}
+	else
+	{
+		ptPrivateData = (videobufreader_PrivateData_T *)ptPrivate->pvPrivateData;
+		ptPrivateData->outputBufferQueue = g_queue_new();
+		ptPrivateData->emptyBufferQueue = g_queue_new();
+		ptPrivateData->allocatedBuffers = g_queue_new();
+
+		tsem_init(&ptPrivateData->tSemConfig, 1);
+	}
+
+	return eError;
+}
+
+static void free_buffer_with_unmap(gpointer data)
+{
+	OMX_Vendor_Common_PrivateData_VideoData_T* videodata = (OMX_Vendor_Common_PrivateData_VideoData_T*)data;
+	if (videodata != NULL)
+	{
+		munmap(videodata->viraddr[0], videodata->allocated_size);
+		g_free(videodata);
+	}
+}
+
+static OMX_ERRORTYPE omx_videobufreader_Destructor(OMX_COMPONENTTYPE *pComp)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	const omx_videobufreader_Private_T *ptPrivate;
+	videobufreader_PrivateData_T *ptPrivateData;
+
+	if(pComp == NULL)
+	{
+		eError = OMX_ErrorBadParameter;
+	}
+	else
+	{
+		ptPrivate = (omx_videobufreader_Private_T *)pComp->pComponentPrivate;
+
+		if(ptPrivate != NULL)
+		{
+			if(ptPrivate->ports != NULL)
+			{
+				if(ptPrivate->ports[0] != NULL)
+				{
+					(void)ptPrivate->ports[0]->PortDestructor(ptPrivate->ports[0]);
+				}
+				g_free(ptPrivate->ports);
+			}
+
+			ptPrivateData = (videobufreader_PrivateData_T *)ptPrivate->pvPrivateData;
+
+			if(ptPrivateData != NULL)
+			{
+				if (ptPrivateData->outputBufferQueue != NULL)
+				{
+					g_queue_free(ptPrivateData->outputBufferQueue);
+					ptPrivateData->outputBufferQueue = NULL;
+				}
+				if (ptPrivateData->emptyBufferQueue != NULL)
+				{
+					g_queue_free(ptPrivateData->emptyBufferQueue);
+					ptPrivateData->emptyBufferQueue = NULL;
+				}
+				if (ptPrivateData->allocatedBuffers != NULL)
+				{
+					g_queue_free_full(ptPrivateData->allocatedBuffers, free_buffer_with_unmap);
+					ptPrivateData->allocatedBuffers = NULL;
+				}
+				tsem_deinit(&ptPrivateData->tSemConfig);
+				g_free(ptPrivateData);
+			}
+			eError = omx_base_source_Destructor(pComp);
+		}
+	}
+	return eError;
+}
+
+static OMX_ERRORTYPE omx_videobufreader_SetConfig(OMX_HANDLETYPE hFx, OMX_INDEXTYPE eConfig, void *pvConfig)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	OMX_COMPONENTTYPE *pComp = (OMX_COMPONENTTYPE *)hFx;
+	const omx_videobufreader_Private_T *ptPrivate = (omx_videobufreader_Private_T *)pComp->pComponentPrivate;
+	videobufreader_PrivateData_T *ptPrivateData = (videobufreader_PrivateData_T *)ptPrivate->pvPrivateData;
+
+	tsem_down(&ptPrivateData->tSemConfig);
+
+	switch(eConfig)
+	{
+	case OMX_IndexVendorConfig_Common_SetCreatePort:
+		{
+			omx_base_PortType *ptPort;
+			const OMX_PARAM_PORTDEFINITIONTYPE *ptPortParam = (OMX_PARAM_PORTDEFINITIONTYPE *)pvConfig;
+
+			if (ptPortParam->eDomain == OMX_PortDomainVideo)
+			{
+				eError = base_video_port_Constructor(hFx, &ptPrivate->ports[OMX_BASE_SOURCE_OUTPUTPORT_INDEX], OMX_BASE_SOURCE_OUTPUTPORT_INDEX, (OMX_BOOL)OMX_FALSE);
+			}
+
+			if(eError != OMX_ErrorNone)
+			{
+				DBG_ERR("failed to port_Constructor");
+				break;
+			}
+
+			ptPort = (omx_base_PortType *)ptPrivate->ports[OMX_BASE_SOURCE_OUTPUTPORT_INDEX];
+			ptPort->sPortParam.nBufferSize 	= ptPortParam->nBufferSize;
+			ptPort->sPortParam.nBufferCountActual = ptPortParam->nBufferCountActual;
+		}
+		break;
+	default:
+		{
+			eError = OMX_ErrorNone;
+		}
+		break;
+	}
+
+	if(eError == OMX_ErrorNone)
+	{
+		eError = omx_videobufreader_SetConfig_videobufreader(hFx, eConfig, pvConfig);
+	}
+
+	tsem_up(&ptPrivateData->tSemConfig);
+
+	return eError;
+}
+
+static OMX_ERRORTYPE omx_videobufreader_SetConfig_videobufreader(OMX_HANDLETYPE hFx, OMX_INDEXTYPE eConfig, void *pvConfig)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	OMX_COMPONENTTYPE *pComp = (OMX_COMPONENTTYPE *)hFx;
+	const omx_videobufreader_Private_T *ptPrivate = (omx_videobufreader_Private_T *)pComp->pComponentPrivate;
+	videobufreader_PrivateData_T *ptPrivateData = (videobufreader_PrivateData_T *)ptPrivate->pvPrivateData;
+
+	switch(eConfig)
+	{
+		case OMX_IndexVendorConfig_VideoBufReader_SetSourceResolution:
+			{
+				const OMX_VendorConfig_Common_Resolution_T *ptResolution = (OMX_VendorConfig_Common_Resolution_T *)pvConfig;
+				(void)memcpy(&ptPrivateData->bufResoution, ptResolution, sizeof(OMX_VendorConfig_Common_Resolution_T));
+				DBG_INFO("set source resolution : %d x %d, w_stride:%d ", ptResolution->size.width, ptResolution->size.height, ptResolution->w_stride);
+			}
+			break;
+
+		case OMX_IndexVendorConfig_VideoBufReader_SetSourceColorFormat:
+			{
+				const OMX_VendorConfig_Common_ColorFormat_T *ptColorFormat = (OMX_VendorConfig_Common_ColorFormat_T *)pvConfig;
+				ptPrivateData->bufColorFormat = ptColorFormat->eColorFormat;
+				DBG_INFO("set source color format %d", ptPrivateData->bufColorFormat);
+			}
+			break;
+
+		case OMX_IndexVendorConfig_VideoBufReader_RequestAllocateBuffer:
+			{
+				OMX_VendorConfig_Common_PhysicalMemInfo *info = (OMX_VendorConfig_Common_PhysicalMemInfo*)pvConfig;
+
+				if (pvConfig == NULL)
+				{
+					DBG_ERR("pvConfig is NULL");
+					eError = OMX_ErrorBadParameter;
+				}
+				else if (ptPrivateData->bufResoution.size.width == 0 || ptPrivateData->bufResoution.size.height == 0)
+				{
+					DBG_ERR("Source resolution is not set. Please to call OMX_IndexVendorConfig_videobufreader_SetSourceResolution");
+					eError = OMX_ErrorInvalidState;
+				}
+				else if (ptPrivateData->bufColorFormat == OMX_COLOR_FormatUnused)
+				{
+					DBG_ERR("Source color format is not set. Please to call OMX_IndexVendorConfig_videobufreader_SetSourceColorFormat");
+					eError = OMX_ErrorInvalidState;
+				}
+				else if (info->base == 0 || info->framesize == 0 || info->nb_frame == 0)
+				{
+					DBG_ERR("Bad parameter");
+					eError = OMX_ErrorBadParameter;
+				}
+				else
+				{
+					int memfd = open("/dev/mem", O_RDWR | O_NDELAY);
+					if (memfd < 0) return OMX_ErrorInsufficientResources;
+
+					DBG_TRACE("Base pysical memory info. base=0x%lx offset=%ld framesize=%d nb_frame=%d",
+						info->base, info->offset, info->framesize, info->nb_frame);
+
+					for (unsigned int i = 0; i < info->nb_frame; i++)
+					{
+						OMX_Vendor_Common_PrivateData_VideoData_T* privVideoData = (OMX_Vendor_Common_PrivateData_VideoData_T*)g_malloc0(sizeof(OMX_Vendor_Common_PrivateData_VideoData_T));
+						uint64_t mem_offset     = info->base + info->offset + (i * info->framesize);
+						uint64_t page_size      = sysconf(_SC_PAGESIZE);
+						uint64_t aligned_offset = mem_offset & ~(page_size - 1);
+
+						void* mmaped_buffer = mmap(NULL,
+												 info->framesize,
+												 PROT_READ | PROT_WRITE,
+												 MAP_SHARED,
+												 memfd,
+												 aligned_offset);
+
+						if (mmaped_buffer == MAP_FAILED)
+						{
+							DBG_ERR("Failed to mmap for framebuffer memory. size=%d, off=%ld errno=%d (%s)",
+								info->framesize, aligned_offset, errno, strerror(errno));
+							eError = OMX_ErrorInsufficientResources;
+							break;
+						}
+						privVideoData->bufferIndex = i;
+						privVideoData->hComponent = hFx;
+						privVideoData->fnDestructor = NULL;
+						privVideoData->phyaddr[0] = aligned_offset;
+						privVideoData->phyaddr[1] = 0;
+						privVideoData->phyaddr[2] = 0;
+						privVideoData->viraddr[0] = mmaped_buffer;
+						privVideoData->viraddr[1] = 0;
+						privVideoData->viraddr[2] = 0;
+						privVideoData->allocated_size = info->framesize;
+						privVideoData->ePrivateData = OMX_Vendor_Common_PrivateData_VideoData;
+						privVideoData->resolution.size.width = ptPrivateData->bufResoution.size.width;
+						privVideoData->resolution.size.height = ptPrivateData->bufResoution.size.height;
+						privVideoData->resolution.w_stride = ptPrivateData->bufResoution.w_stride;
+						privVideoData->colorFormat.eColorFormat = ptPrivateData->bufColorFormat;
+
+						DBG_INFO(" %d : Buffer is allocated. vaddr=%p paddr=0x%lx size=%d",
+							 i, privVideoData->viraddr[0], (unsigned long)privVideoData->phyaddr[0], info->framesize);
+
+						g_queue_push_tail(ptPrivateData->emptyBufferQueue, privVideoData);
+						g_queue_push_tail(ptPrivateData->allocatedBuffers, privVideoData);
+					}
+					close(memfd);
+				}
+			}
+			break;
+
+		case OMX_IndexVendorConfig_VideoBufReader_PushData:
+			{
+				if (pvConfig != NULL)
+				{
+					OMX_Vendor_Common_PrivateData_VideoData_T *ptFilledBuf  = (OMX_Vendor_Common_PrivateData_VideoData_T *)pvConfig;
+					DBG_TRACE("OMX_IndexVendorConfig_videobufreader_PushData : Push buffer(%d,) into Output BufferQ", ptFilledBuf->bufferIndex);
+					g_queue_push_tail(ptPrivateData->outputBufferQueue, ptFilledBuf);
+				}
+				else
+				{
+					eError = OMX_ErrorBadParameter;
+				}
+			}
+			break;
+		case OMX_IndexVendorConfig_VideoBufReader_ReturnUsedBuffer:
+			{
+				if (pvConfig != NULL)
+				{
+					OMX_Vendor_Common_PrivateData_VideoData_T *ptUsedBuf = (OMX_Vendor_Common_PrivateData_VideoData_T *)pvConfig;
+
+					g_queue_push_tail(ptPrivateData->emptyBufferQueue, ptUsedBuf);
+					DBG_TRACE("OMX_IndexVendorConfig_VideoBufReader_ReturnUsedBuffer :Buffer(%d) into Empty BufferQ=%d",
+						ptUsedBuf->bufferIndex, g_queue_get_length(ptPrivateData->emptyBufferQueue));
+				}
+				else
+				{
+					eError = OMX_ErrorBadParameter;
+				}
+			}
+			break;
+		case OMX_IndexVendorConfig_VideoBufReader_SetStart:
+			{
+				ptPrivateData->eState = videobufreader_State_Start;
+			}
+			break;
+
+		case OMX_IndexVendorConfig_VideoBufReader_SetStop:
+			{
+				ptPrivateData->eState = videobufreader_State_Stop;
+			}
+			break;
+
+		default:
+			{
+				eError = OMX_ErrorNone;
+			}
+			break;
+	}
+
+	return eError;
+}
+
+static OMX_ERRORTYPE omx_videobufreader_GetConfig(OMX_HANDLETYPE hFx, OMX_INDEXTYPE eConfig, void *pvConfig)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	const OMX_COMPONENTTYPE *pComp = (OMX_COMPONENTTYPE *)hFx;
+	const omx_videobufreader_Private_T *ptPrivate = (omx_videobufreader_Private_T *)pComp->pComponentPrivate;
+	videobufreader_PrivateData_T *ptPrivateData = (videobufreader_PrivateData_T *)ptPrivate->pvPrivateData;
+
+	tsem_down(&ptPrivateData->tSemConfig);
+
+	switch(eConfig)
+	{
+	case OMX_IndexVendorConfig_VideoBufReader_GetEmptyBuffer:
+		{
+			if (pvConfig != NULL)
+			{
+				OMX_Vendor_Common_PrivateData_VideoData_T **ppBuf = (OMX_Vendor_Common_PrivateData_VideoData_T **)pvConfig;
+				OMX_Vendor_Common_PrivateData_VideoData_T *from_queue = g_queue_pop_head(ptPrivateData->emptyBufferQueue);
+				if (from_queue != NULL)
+				{
+					DBG_TRACE("Got EmptyBuffer from EmptyBufferQueue=%d", g_queue_get_length(ptPrivateData->emptyBufferQueue));
+					*ppBuf = from_queue;
+				}
+				else
+				{
+					eError = OMX_ErrorNotReady;
+				}
+			}
+			else
+			{
+				eError = OMX_ErrorBadParameter;
+			}
+		}
+		break;
+	default:
+		{
+			OMX_INDEXTYPE nIndex = (OMX_INDEXTYPE)eConfig;
+			eError = omx_base_component_GetConfig(hFx, nIndex, pvConfig);
+		}
+		break;
+	}
+
+	tsem_up(&ptPrivateData->tSemConfig);
+
+	return eError;
+}
+
+static void omx_videobufreader_BufferMgmtCallback(OMX_COMPONENTTYPE *pComp, OMX_BUFFERHEADERTYPE *ptOutputBufferHeader)
+{
+	const omx_videobufreader_Private_T *ptPrivate = (omx_videobufreader_Private_T *)pComp->pComponentPrivate;
+	videobufreader_PrivateData_T *ptPrivateData = (videobufreader_PrivateData_T *)ptPrivate->pvPrivateData;
+
+	tsem_down(&ptPrivateData->tSemConfig);
+
+	if((ptPrivateData->eState == videobufreader_State_Stop) || (ptPrivateData->reachEos == (OMX_BOOL)OMX_TRUE))
+	{
+		ptOutputBufferHeader->nFilledLen = 0;
+	}
+	else
+	{
+		OMX_Vendor_Common_PrivateData_VideoData_T *ptQueuedBuf = g_queue_pop_head(ptPrivateData->outputBufferQueue);
+
+		if (ptQueuedBuf != NULL)
+		{
+			DBG_TRACE("Got buffer(%d) from Output Buffer queue", ptQueuedBuf->bufferIndex);
+			ptOutputBufferHeader->nFilledLen  = sizeof(OMX_Vendor_Common_PrivateData_VideoData_T);;
+			ptOutputBufferHeader->pVendorPrivate = ptQueuedBuf;
+			if (ptQueuedBuf->bytesused == 0u)
+			{
+				ptOutputBufferHeader->nFlags |= OMX_BUFFERFLAG_EOS;
+			}
+			DBG_TRACE("Send buffer(%p, len=%ld) to connected component", ptOutputBufferHeader->pBuffer, ptOutputBufferHeader->nFilledLen);
+
+			if ((ptOutputBufferHeader->nFlags & OMX_BUFFERFLAG_EOS) != 0U)
+			{
+				DBG_INFO("Reach EOS");
+				(void)(*(ptPrivate->callbacks->EventHandler))(
+					(OMX_HANDLETYPE)pComp,
+					ptPrivate->callbackData,
+					OMX_EventBufferFlag,
+					ptOutputBufferHeader->nFlags,
+					0,
+					NULL);
+
+				ptPrivateData->reachEos = (OMX_BOOL)OMX_TRUE;
+			}
+		}
+	}
+
+	tsem_up(&ptPrivateData->tSemConfig);
+
+	(void)g_usleep(1000);
+}
+
+static OMX_ERRORTYPE omx_videobufreader_DoStateSet(OMX_COMPONENTTYPE *pComp, OMX_STATETYPE eDestState)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	const omx_videobufreader_Private_T *ptPrivate = (omx_videobufreader_Private_T *)pComp->pComponentPrivate;
+	videobufreader_PrivateData_T *ptPrivateData = (videobufreader_PrivateData_T *)ptPrivate->pvPrivateData;
+
+	if(ptPrivate->state == OMX_StateIdle)
+	{
+		ptPrivateData->reachEos = (OMX_BOOL)OMX_FALSE;
+		ptPrivateData->eState = videobufreader_State_Stop;
+	}
+
+	eError = omx_base_component_DoStateSet(pComp, (OMX_U32)eDestState);
+
+	return eError;
+}
+
+OMX_ERRORTYPE OMX_ComponentInit(OMX_HANDLETYPE hComponent, OMX_STRING pstrCompName)
+{
+	OMX_COMPONENTTYPE* ptComponent = NULL;
+	P_CAST(ptComponent, hComponent);
+
+	return omx_videobufreader_Constructor(ptComponent, pstrCompName);
+}
