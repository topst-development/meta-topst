+static OMX_ERRORTYPE CreateComponents(IL_handle handle)
+{
+	Omx_Core_T *omx_core;
+	buffervencData_T* ctx = (buffervencData_T*)handle;
+
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+
+	DBG("Creating omx components");
+
+	if (ctx == NULL)
+	{
+		eError = OMX_ErrorBadParameter;
+	}
+	else
+	{
+		omx_core = &ctx->omxcore;
+
+		tsem_init(&ctx->sem_reader, 0);
+		tsem_init(&ctx->sem_videnc, 0);
+		tsem_init(&ctx->sem_fakesink, 0);
+
+		eError = omx_core->sym.get_handle(&ctx->handle_reader, "OMX.TCC.videobufreader", (OMX_PTR)ctx, &callback_reader);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed get handle. reader component\n", __func__, __LINE__);
+			return eError;
+		}
+
+		eError = omx_core->sym.get_handle(&ctx->handle_vidscaler, "OMX.TCC.videoscaler", (OMX_PTR)ctx, &callback_vidscaler);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed get handle. video scaler component\n", __func__, __LINE__);
+			return eError;
+		}
+
+		eError = omx_core->sym.get_handle(&ctx->handle_videnc, "OMX.TCC.h265enc", (OMX_PTR)ctx, &callback_videnc);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed get handle. video encoder component\n", __func__, __LINE__);
+			return eError;
+		}
+
+		eError = omx_core->sym.get_handle(&ctx->handle_fakesink, "OMX.TCC.fakesink", (OMX_PTR)ctx, &callback_fakesink);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed get handle. fakesink component\n", __func__, __LINE__);
+			return eError;
+		}
+	}
+
+	DBG("Success. omx components are created.");
+
+	return eError;
+}
+
+static void DestroyComponents(IL_handle handle)
+{
+	Omx_Core_T *omx_core;
+	buffervencData_T* ctx = (buffervencData_T*)handle;
+
+	if (ctx != NULL)
+	{
+		omx_core = &ctx->omxcore;
+
+		DBG("free reader");
+		if (ctx->handle_reader != NULL)
+		{
+			omx_core->sym.free_handle(ctx->handle_reader);
+			ctx->handle_reader = NULL;
+		}
+		DBG("free vidscaler");
+
+		if (ctx->handle_vidscaler != NULL)
+		{
+			omx_core->sym.free_handle(ctx->handle_vidscaler);
+			ctx->handle_vidscaler = NULL;
+		}
+		DBG("free videnc");
+		if (ctx->handle_videnc != NULL)
+		{
+			omx_core->sym.free_handle(ctx->handle_videnc);
+			ctx->handle_videnc = NULL;
+		}
+#if 0
+		DBG("free fakesink");
+		if (ctx->handle_fakesink != NULL)
+		{
+			omx_core->sym.free_handle(ctx->handle_fakesink);
+			ctx->handle_fakesink = NULL;
+		}
+#endif
+		tsem_deinit(&ctx->sem_reader);
+		tsem_deinit(&ctx->sem_vidscaler);
+		tsem_deinit(&ctx->sem_videnc);
+		tsem_deinit(&ctx->sem_fakesink);
+	}
+}
