+#ifndef OMX_VIDEO_BUFFREADER_H
+#define OMX_VIDEO_BUFFREADER_H
+
+/**
+ * @brief A structure representing the private data of the file reader.
+ * 
+ * This structure contains the private data of the file reader.
+ */
+typedef struct
+{
+	omx_base_source_PrivateType_FIELDS;		/** The base private data of the video buffer reader. */
+	void *pvPrivateData;					/** A pointer to the private data. */
+} omx_videobufreader_Private_T;
+
+OMX_ERRORTYPE OMX_ComponentInit(OMX_HANDLETYPE hComponent, OMX_STRING pstrCompName);
+
+#endif	// OMX_VIDEO_BUFFREADER_H
