+static OMX_ERRORTYPE ConfigureComponents(IL_handle handle)
+{
+	buffervencData_T *ctx = (buffervencData_T *)handle;
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+
+	OMX_VendorConfig_VideoEnc_Resolution_T tVidencRes;
+	OMX_VendorConfig_VideoEnc_FrameRate_T tVidencFPS;
+	OMX_VendorConfig_VideoEnc_ColorFormat_T tVidencColorFormat;
+	OMX_VendorConfig_VideoEnc_Bitrate_T tVidencBitrate;
+	OMX_VendorConfig_VideoEnc_KeyFrameInterval_T tVidencKeyFrameInterval;
+
+	OMX_VendorConfig_Common_Name_T tVScalerDevName;
+	OMX_VendorConfig_Common_PhysicalMemInfo tVScalerPmap;
+	OMX_VendorConfig_Common_Resolution_T tVideoSrcRes;
+	OMX_VendorConfig_Common_ColorFormat_T tVideoSrcColor;
+	OMX_VendorConfig_Common_Region_T tVScalerSrcCrop;
+	OMX_VendorConfig_Common_Resolution_T tVScalerDstRes;
+	OMX_VendorConfig_Common_ColorFormat_T tVScalerDstColor;
+	pmap_t readerPhysicalMemInfo;
+	pmap_t scalerPhysicalMemInfo;
+	OMX_VendorConfig_Common_PhysicalMemInfo tVReaderPmap;
+
+	DBG("Configuring components");
+
+	if (ctx == NULL)
+	{
+		eError = OMX_ErrorBadParameter;
+	}
+	else
+	{
+		// Configure video buffer reader component
+		tVideoSrcRes.size.width = BUFFER_IMG_WIDTH;
+		tVideoSrcRes.size.height = BUFFER_IMG_HEIGHT;
+		tVideoSrcRes.w_stride = tVideoSrcRes.size.width;
+		(void)set_config(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_SetSourceResolution, (OMX_PTR)&tVideoSrcRes);
+
+		tVideoSrcColor.eColorFormat = BUFFER_IMG_FORMAT;
+		(void)set_config(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_SetSourceColorFormat, (OMX_PTR)&tVideoSrcColor);
+
+		pmap_get_info(VREADER_PMAPNAME, &readerPhysicalMemInfo);
+		tVReaderPmap.base = readerPhysicalMemInfo.base;
+		tVReaderPmap.offset = 0;
+		tVReaderPmap.framesize = BUFFER_IMG_FRAME_SIZE;
+		tVReaderPmap.nb_frame = 4;
+
+		eError = set_config(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_RequestAllocateBuffer, (OMX_PTR)&tVReaderPmap);
+
+		if (eError != OMX_ErrorNone)
+		{
+			DBG("Failed to allocate buffer");
+			return eError;
+		}
+
+		// Configure video scaler component
+		strcpy(tVScalerDevName.name, VSCALER_DEVNMAE);
+		(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_VideoScaler_SetDevice, (OMX_PTR)&tVScalerDevName);
+
+		tVideoSrcRes.size.width = BUFFER_IMG_WIDTH;
+		tVideoSrcRes.size.height = BUFFER_IMG_HEIGHT;
+		tVideoSrcRes.w_stride = tVideoSrcRes.size.width;
+		(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_VideoScaler_SetSourceResolution, (OMX_PTR)&tVideoSrcRes);
+
+		tVideoSrcColor.eColorFormat = BUFFER_IMG_FORMAT;
+		(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_VideoScaler_SetSourceColorFormat, (OMX_PTR)&tVideoSrcColor);
+
+		tVScalerSrcCrop.origin.x = 0;
+		tVScalerSrcCrop.origin.y = 0;
+		tVScalerSrcCrop.size.width = tVideoSrcRes.size.width;
+		tVScalerSrcCrop.size.height = tVideoSrcRes.size.height;
+		(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_VideoScaler_SetScaleRegion, (OMX_PTR)&tVScalerSrcCrop);
+
+		tVScalerDstRes.size.width = VID_WIDTH;
+		tVScalerDstRes.size.height = VID_HEIGHT;
+		tVScalerDstRes.w_stride = tVScalerDstRes.size.width;
+		(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_VideoScaler_SetTargetResolution, (OMX_PTR)&tVScalerDstRes);
+
+		tVScalerDstColor.eColorFormat = VID_FORMAT;
+		(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_VideoScaler_SetTargetColorFormat, (OMX_PTR)&tVScalerDstColor);
+
+		pmap_get_info(VSCALER_PMAPNAME, &scalerPhysicalMemInfo);
+		tVScalerPmap.base = scalerPhysicalMemInfo.base;
+		tVScalerPmap.offset = 0;
+		tVScalerPmap.framesize = tVScalerDstRes.size.width * tVScalerDstRes.size.height * 3 / 2;
+		tVScalerPmap.nb_frame = 4;
+
+		(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_VideoScaler_SetPmapInfo, (OMX_PTR)&tVScalerPmap);
+
+		// Configure video encoder component
+		tVidencRes.iWidth 	= tVScalerDstRes.size.width;
+		tVidencRes.iHeight 	= tVScalerDstRes.size.height;
+		(void)set_config(ctx->handle_videnc, OMX_IndexVendorConfig_VideoEnc_SetResolution, (OMX_PTR)&tVidencRes);
+
+		tVidencFPS.iNum 	= VID_FPS;
+		tVidencFPS.iDen 	= 1;
+		(void)set_config(ctx->handle_videnc, OMX_IndexVendorConfig_VideoEnc_SetFrameRate, (OMX_PTR)&tVidencFPS);
+
+		tVidencColorFormat.eColorFormat = tVScalerDstColor.eColorFormat;
+		(void)set_config(ctx->handle_videnc, OMX_IndexVendorConfig_VideoEnc_SetColorFormat, (OMX_PTR)&tVidencColorFormat);
+
+		tVidencBitrate.iBitrate = VID_BITRATE;
+		(void)set_config(ctx->handle_videnc, OMX_IndexVendorConfig_VideoEnc_SetBitrate, (OMX_PTR)&tVidencBitrate);
+
+		tVidencKeyFrameInterval.iKeyFrameInterval = VID_GOP;
+		(void)set_config(ctx->handle_videnc, OMX_IndexVendorConfig_VideoEnc_SetKeyFrameInterval, (OMX_PTR)&tVidencKeyFrameInterval);
+	}
+
+	DBG("Success. components are configured");
+
+	return eError;
+}
