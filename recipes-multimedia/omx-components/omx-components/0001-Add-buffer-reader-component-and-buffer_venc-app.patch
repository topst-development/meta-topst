+int main(int argc, char *argv[])
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	IL_handle handle = NULL;
+
+	if (argc < 2)
+	{
+		fprintf(stderr, "Usage: %s [rgb_file.rgb]\n", argv[0]);
+		return EXIT_FAILURE;
+	}
+
+	for (int i = 1; i < argc; ++i)
+	{
+		if (strcmp(argv[i], "--loop") == 0)
+		{
+			g_loop = true;
+		}
+	}
+
+	handle = (IL_handle)LoadOmxcore();
+
+	if (handle != NULL)
+	{
+		eError = CreateComponents(handle);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed to create omx components.", __func__, __LINE__);
+			return 0;
+		}
+
+		eError = ConfigureComponents(handle);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed to configure omx components.", __func__, __LINE__);
+			return 0;
+		}
+
+		eError = CreatePipeline(handle);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed to create pipeline.", __func__, __LINE__);
+			return 0;
+		}
+
+		eError = StartPipeline(handle);
+
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed to start pipeline.", __func__, __LINE__);
+			return 0;
+		}
+
+		printf("Start video encoding \n");
+		Push_rgb_frames(handle, argv[1]);
+
+		eError = StopPipeline(handle);
+		if(eError != OMX_ErrorNone)
+		{
+			printf("[%s:%d] Failed to stop pipeline.", __func__, __LINE__);
+			return 0;
+		}
+
+		printf("Stop video encoding \n");
+
+		DestroyPipeline(handle);
+		DestroyComponents(handle);
+		UnLoadOmxcore(handle);
+
+		printf("Bye!!\n");
+	}
+	return 0;
+}
