+static void eventhandlerCommon(OMX_HANDLETYPE component_handle,
+										OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
+										OMX_U32 nData1, OMX_U32 nData2, OMX_PTR pEventData,
+										tsem_t *sema)
+{
+	switch (eEvent)
+	{
+	case OMX_EventCmdComplete:
+		{
+			OMX_COMMANDTYPE cmd = (OMX_COMMANDTYPE)nData1;
+			OMX_STATETYPE state = (OMX_STATETYPE)nData2;
+
+			if (cmd == OMX_CommandStateSet)
+			{
+				if ((state == OMX_StateLoaded) || (state == OMX_StateIdle)
+					|| (state == OMX_StateExecuting)/* || (state == OMX_StatePause)*/)
+				{
+					(void)tsem_up(sema);
+				}
+			}
+			else if (cmd == OMX_CommandFlush)
+			{
+				OMX_VendorConfig_Common_Flush_T tFlush;
+				tFlush.iPortIdx = nData2;
+				(void)set_config(component_handle, OMX_IndexVendorConfig_Common_SetFlushComplete, &tFlush);
+				(void)tsem_up(sema);
+			}
+			else
+			{
+				;
+			}
+		}
+		break;
+	case OMX_EventError:
+		{
+			OMX_ERRORTYPE err = (OMX_ERRORTYPE)nData1;
+
+			if (err == OMX_ErrorSameState)
+			{
+				(void)tsem_up(sema);
+			}
+		}
+		break;
+	case OMX_EventBufferFlag:
+		{
+			if(nData2 & OMX_BUFFERFLAG_EOS)
+			{
+				(void)tsem_up(sema);
+			}
+			break;
+		}
+	default:
+		{
+			// do nothing
+		}
+		break;
+	}
+}
