+static buffervencData_T* LoadOmxcore(void)
+{
+	Omx_Core_T *omx_core;
+
+	buffervencData_T *ctx;
+
+	ctx = (buffervencData_T *)calloc(1, sizeof(buffervencData_T));
+
+	DBG("Loading omx core");
+
+	if (ctx == NULL)
+	{
+		return NULL;
+	}
+
+	omx_core = &ctx->omxcore;
+
+	omx_core->hvHandle = dlopen("libtcc_omxcore.so", RTLD_LAZY);
+
+	if (omx_core->hvHandle == NULL)
+	{
+		free(ctx);
+		printf("Failed to open shared object : [reason : %s]\n", dlerror());
+		return NULL;
+	}
+	else
+	{
+		omx_core->sym.init = dlsym(omx_core->hvHandle, "OMX_Init");
+		if (omx_core->sym.init == NULL)
+		{
+			(void)dlclose(omx_core->hvHandle);
+			omx_core->hvHandle = NULL;
+			free(ctx);
+			return NULL;
+		}
+		omx_core->sym.deinit 			= dlsym(omx_core->hvHandle, "OMX_Deinit");
+		if (omx_core->sym.deinit == NULL)
+		{
+			(void)dlclose(omx_core->hvHandle);
+			omx_core->hvHandle = NULL;
+			free(ctx);
+			return NULL;
+		}
+		omx_core->sym.get_handle 		= dlsym(omx_core->hvHandle, "OMX_GetHandle");
+		if (omx_core->sym.get_handle == NULL)
+		{
+			(void)dlclose(omx_core->hvHandle);
+			omx_core->hvHandle = NULL;
+			free(ctx);
+			return NULL;
+		}
+		omx_core->sym.free_handle 		= dlsym(omx_core->hvHandle, "OMX_FreeHandle");
+		if (omx_core->sym.free_handle == NULL)
+		{
+			(void)dlclose(omx_core->hvHandle);
+			omx_core->hvHandle = NULL;
+			free(ctx);
+			return NULL;
+		}
+		omx_core->sym.setup_tunnel 	= dlsym(omx_core->hvHandle, "OMX_SetupTunnel");
+		if (omx_core->sym.setup_tunnel == NULL)
+		{
+			(void)dlclose(omx_core->hvHandle);
+			omx_core->hvHandle = NULL;
+			free(ctx);
+			return NULL;
+		}
+
+		omx_core->sym.init;
+
+		DBG("Success. omx core is loaded.");
+
+		return ctx;
+	}
+}
+
+static void UnLoadOmxcore(buffervencData_T *ctx)
+{
+	Omx_Core_T *omx_core;
+	DBG("UnLoading omx core");
+
+	if (ctx != NULL)
+	{
+		omx_core = &ctx->omxcore;
+		omx_core->sym.deinit();
+		(void)dlclose(omx_core->hvHandle);
+		free(ctx);
+	}
+	DBG("Success. omx core is unloaded.");
+}
