+				struct tm _tm;	\
+				clock_gettime(CLOCK_REALTIME, &_now); 	\
+				localtime_r(&_now.tv_sec, &_tm);	 \
+				printf("[%04d-%02d-%02d %02d:%02d:%02d.%03ld][%s:%d]" fmt "\n", _tm.tm_year + 1900, _tm.tm_mon+1, _tm.tm_mday, _tm.tm_hour, _tm.tm_min, _tm.tm_sec, _now.tv_nsec/1000000, __FUNCTION__, __LINE__, ## args); \
+			}while(0)
