+static void Push_rgb_frames(IL_handle handle, char* source_file_name)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	buffervencData_T *ctx = (buffervencData_T *)handle;
+	FILE *fp = fopen(source_file_name, "rb");
+
+	if (!fp)
+	{
+		perror("Failed to open RGB file");
+		return;
+	}
+	eError = set_config(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_SetStart, NULL);
+
+	if (eError != OMX_ErrorNone)
+	{
+		perror("Failed to start buffer reader.");
+		return;
+	}
+
+	while (1)
+	{
+		OMX_Vendor_Common_PrivateData_VideoData_T* videodata = NULL;
+		eError = get_config(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_GetEmptyBuffer, &videodata);
+		if (eError == OMX_ErrorNotReady)
+		{
+			usleep(5000);
+			continue;
+		}
+
+		size_t read_size = fread(videodata->viraddr[0], 1, BUFFER_IMG_FRAME_SIZE, fp);
+		bool is_eos = (read_size < BUFFER_IMG_FRAME_SIZE);
+
+		if ((g_loop == true) && (is_eos == true))
+		{
+			fseek(fp, 0, SEEK_SET);
+			read_size = fread(videodata->viraddr[0], 1, BUFFER_IMG_FRAME_SIZE, fp);
+			is_eos = false;
+		}
+
+		videodata->bytesused = (is_eos == true) ? 0 : read_size;
+		eError = set_config(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_PushData, videodata);
+		if (eError != OMX_ErrorNone)
+		{
+			fprintf(stderr, "OMX_SetConfig(PushData) failed: 0x%08x\n", eError);
+			break;
+		}
+
+		if (is_eos == true)
+		{
+			break;
+		}
+	}
+	while (g_end_of_stream == false)
+	{
+		// Wait until all straem is processed
+		usleep(1000);
+	}
+}
+
+static void* save_file_thread(void* priv)
+{
+	VideoReader_T* pReader = (VideoReader_T*)priv;
+
+	DBG("Start saving file thread");
+
+	while (pReader->isRunning == true)
+	{
+		OMX_BUFFERHEADERTYPE *buf = NULL;
+
+		g_mutex_lock(&pReader->queue_mutex);
+
+		while ((g_queue_is_empty(pReader->save_queue) && (pReader->isRunning == true)))
+		{
+			g_cond_wait(&pReader->queue_cond, &pReader->queue_mutex);
+		}
+
+		if (!g_queue_is_empty(pReader->save_queue))
+		{
+			buf = g_queue_pop_head(pReader->save_queue);
+		}
+
+		g_mutex_unlock(&pReader->queue_mutex);
+
+		if (buf != NULL)
+		{
+			fwrite(buf->pBuffer, 1, buf->nFilledLen, pReader->dump_fp);
+			fflush(pReader->dump_fp);
+			g_free(buf->pBuffer);
+			g_free(buf);
+		}
+	}
+}
