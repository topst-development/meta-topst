+static OMX_ERRORTYPE emptyBufferDoneVscaler(OMX_HANDLETYPE component_handle, OMX_PTR pAppData, OMX_BUFFERHEADERTYPE *pBuffer)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	buffervencData_T* ctx = (buffervencData_T *)pAppData;
+	OMX_Vendor_Common_PrivateData_VideoData_T* videodata = NULL;
+
+	if(pBuffer != NULL)
+	{
+		videodata = (OMX_Vendor_Common_PrivateData_VideoData_T*)pBuffer->pVendorPrivate;
+		eError = set_config(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_ReturnUsedBuffer, videodata);
+	}
+	else
+	{
+		eError = OMX_ErrorBadParameter;
+	}
+	return eError;
+}
+
+static OMX_ERRORTYPE fillBufferDoneVenc(OMX_HANDLETYPE component_handle, OMX_PTR pAppData, OMX_BUFFERHEADERTYPE *pBuffer)
+{
+	buffervencData_T* ctx = (buffervencData_T*)pAppData;
+	VideoReader_T* pReader = &ctx->videoReader;
+
+	if ((pBuffer != NULL) && (pBuffer->nFilledLen > 0))
+	{
+		g_mutex_lock(&pReader->queue_mutex);
+
+		OMX_BUFFERHEADERTYPE *saved_buf = g_malloc0(sizeof(OMX_BUFFERHEADERTYPE));
+		memcpy(saved_buf, pBuffer, sizeof(OMX_BUFFERHEADERTYPE));
+		saved_buf->pBuffer = g_malloc(pBuffer->nFilledLen);
+
+		memcpy(saved_buf->pBuffer, pBuffer->pBuffer, pBuffer->nFilledLen);
+
+		g_queue_push_tail(pReader->save_queue, saved_buf);
+		g_cond_signal(&pReader->queue_cond);
+
+		g_mutex_unlock(&pReader->queue_mutex);
+	}
+	return OMX_ErrorNone;
+}
