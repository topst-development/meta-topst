+static void DestroyPipeline(IL_handle handle)
+{
+	buffervencData_T *ctx = (buffervencData_T *)handle;
+
+	DBG("Destroying pipeline");
+
+	if (ctx != NULL)
+	{
+		setStateToload(ctx);
