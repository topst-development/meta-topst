+static OMX_ERRORTYPE emptyBufferDone(OMX_HANDLETYPE component_handle, OMX_PTR pAppData, OMX_BUFFERHEADERTYPE *pBuffer)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	OMX_Vendor_Common_PrivateData_T *vendorData;
+
+	if(pBuffer != NULL)
+	{
+		vendorData = pBuffer->pVendorPrivate;
+		if(vendorData != NULL)
+		{
+			if(vendorData->fnDestructor != NULL)
+			{
+				(void)vendorData->fnDestructor(pBuffer->pVendorPrivate);
+			}
+			else
+			{
+				free(pBuffer->pVendorPrivate);
+			}
+		}
+	}
+	else
+	{
+		eError = OMX_ErrorBadParameter;
+	}
+	return eError;
+}
