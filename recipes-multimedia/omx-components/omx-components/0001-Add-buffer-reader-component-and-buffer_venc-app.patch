diff --git a/omx_videobufreader_component/CMakeLists.txt b/omx_videobufreader_component/CMakeLists.txt
new file mode 100644
index 0000000..fb1ac82
--- /dev/null
+++ b/omx_videobufreader_component/CMakeLists.txt
@@ -0,0 +1,31 @@
+CMAKE_MINIMUM_REQUIRED(VERSION 2.8)
+
+SET(OUTPUT_ELF "omxvideobufreader")
+
+SET(SRC_FILES
+	${CMAKE_CURRENT_SOURCE_DIR}/src/omx_videobufreader_component.c
+	)
+
+INCLUDE_DIRECTORIES(
+	${CMAKE_CURRENT_SOURCE_DIR}/include
+	${CMAKE_SOURCE_DIR}/omx_include
+	${CMAKE_SOURCE_DIR}/omx_vendor_include
+	${CMAKE_SOURCE_DIR}/omx_base/include
+	${CMAKE_SOURCE_DIR}/omx_tools/include
+	${GLIB2_INCLUDE_DIRS}
+	${TUTIL_INCLUDE_DIRS}
+	)
+
+ADD_COMPILE_OPTIONS(-g -Wall)
+
+LINK_LIBRARIES(omxbase ${GLIB2_LIBRARIES} ${TUTIL_LIBRARIES})
+
+ADD_LIBRARY(${OUTPUT_ELF} SHARED ${SRC_FILES})
+
+INSTALL(TARGETS ${OUTPUT_ELF}
+	RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+	LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+	ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+	)
+
+SET_TARGET_PROPERTIES(${OUTPUT_ELF} PROPERTIES LIBRARY_OUTPUT_DIRECTORY ${LIBDIR})
