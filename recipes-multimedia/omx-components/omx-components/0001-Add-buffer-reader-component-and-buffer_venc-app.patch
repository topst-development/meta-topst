+static OMX_ERRORTYPE StartPipeline(IL_handle handle)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	buffervencData_T *ctx = (buffervencData_T *)handle;
+	time_t timer;
+	struct tm *t;
+	char dump_time[64];
+	char dumppath[1024];
+
+	DBG("Starting pipeline");
+
+	memset(dump_time, 0x00, 64);
+
+	timer = time(NULL);
+	t = localtime(&timer);
+	sprintf(dump_time, "%04d%02d%02d_%02d%02d%02d", t->tm_year +1900, t->tm_mon+1, t->tm_mday,  t->tm_hour, t->tm_min, t->tm_sec);
+	DBG("date: %s", dump_time);
+
+	ctx->videoReader.isRunning = true;
+	sprintf(dumppath, "/home/root/video_%s.hevc", dump_time);
+	ctx->videoReader.dump_fp = fopen(dumppath, "wb");
+	if (!ctx->videoReader.dump_fp)
+	{
+		perror("Failed to open hevc dump file");
+		eError = OMX_ErrorHardware;
+	}
+	else
+	{
+		ctx->videoReader.save_queue = g_queue_new();
+		g_mutex_init(&ctx->videoReader.queue_mutex);
+		g_cond_init(&ctx->videoReader.queue_cond);
+
+		pthread_create(&ctx->videoReader.hThread, NULL, save_file_thread, &ctx->videoReader);
+
+		eError = setStateToExecute((buffervencData_T *)handle);
+		if (eError != OMX_ErrorNone)
+		{
+			DBG("Failed to set excute state");
+		}
+		else
+		{
+			DBG("Success. pipeline is started.");
+		}
+	}
+	return eError;
+}
+
+static OMX_ERRORTYPE StopPipeline(IL_handle handle)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	buffervencData_T *ctx = (buffervencData_T *)handle;
+
+	DBG("Stopping pipeline");
+	(void)OMX_SetConfig(ctx->handle_reader, OMX_IndexVendorConfig_VideoBufReader_SetStop, NULL);
+
+	if(ctx->videoReader.isRunning)
+	{
+		DBG("video reader thread finish!!, wait to join...");
+		ctx->videoReader.isRunning = false;
+		g_mutex_lock(&ctx->videoReader.queue_mutex);
+		g_cond_signal(&ctx->videoReader.queue_cond);
+		g_mutex_unlock(&ctx->videoReader.queue_mutex);
+		pthread_join(ctx->videoReader.hThread, NULL);
+		DBG("video reader thread finished!!");
+	}
+
+	eError = setStateToIdle((buffervencData_T *)handle);
+
+	DBG("Success. pipeline is stopped.");
+
+	return eError;
+}
