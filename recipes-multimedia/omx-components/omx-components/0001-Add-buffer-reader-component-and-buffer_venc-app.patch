+static OMX_ERRORTYPE CreatePipeline(IL_handle handle)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+	buffervencData_T *ctx = (buffervencData_T *)handle;
+	OMX_PARAM_PORTDEFINITIONTYPE port_def;
+	Omx_Core_T* omx_core;
+
+	DBG("Creating pipeline");
+
+	if (ctx == NULL)
+	{
+		return OMX_ErrorBadParameter;
+	}
+
+	omx_core = &ctx->omxcore;
+
+	(void)memset(&port_def, 0, sizeof(OMX_PARAM_PORTDEFINITIONTYPE));
+	setHeader(&port_def, sizeof(OMX_PARAM_PORTDEFINITIONTYPE));
+
+	DBG("Create ports on each components");
+	port_def.eDomain = OMX_PortDomainVideo;
+	port_def.nBufferCountActual = 4;
+	port_def.nBufferCountMin = 4;
+	port_def.nPortIndex = 0;
+	(void)set_config(ctx->handle_reader, OMX_IndexVendorConfig_Common_SetCreatePort, &port_def);
+
+	port_def.nPortIndex = 0;
+	(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_Common_SetCreatePort, &port_def);
+	port_def.nPortIndex = 1;
+	(void)set_config(ctx->handle_vidscaler, OMX_IndexVendorConfig_Common_SetCreatePort, &port_def);
+
+	port_def.nPortIndex = 0;
+	(void)set_config(ctx->handle_videnc, OMX_IndexVendorConfig_Common_SetCreatePort, &port_def);
+	port_def.nPortIndex = 1;
+	(void)set_config(ctx->handle_videnc, OMX_IndexVendorConfig_Common_SetCreatePort, &port_def);
+
+	port_def.nPortIndex = 0;
+	(void)set_config(ctx->handle_fakesink, OMX_IndexVendorConfig_Common_SetCreatePort, &port_def);
+
+	DBG("Connect components");
+	eError = omx_core->sym.setup_tunnel(ctx->handle_reader, 0, ctx->handle_vidscaler, 0);
+
+	if(eError != OMX_ErrorNone)
+	{
+		DBG("Failed to connect reader - video scaler component. err=0x%x", eError);
+		return eError;
+	}
+
+	eError = omx_core->sym.setup_tunnel(ctx->handle_vidscaler, 1, ctx->handle_videnc, 0);
+
+	if(eError != OMX_ErrorNone)
+	{
+		DBG("Failed to connect video scaler - video enc component. err=0x%x", eError);
+		return eError;
+	}
+
+	eError = omx_core->sym.setup_tunnel(ctx->handle_videnc, 1, ctx->handle_fakesink, 0);
+
+	if(eError != OMX_ErrorNone)
+	{
+		DBG("Failed to connect video enc - fakesink component. err=0x%x", eError);
+		return eError;
+	}
+
+	DBG("Set omx state into Loaded -> IDLE");
+	eError = setStateToIdle(ctx);
+
+	if(eError != OMX_ErrorNone)
+	{
+		DBG("Failed to set state into IDLE");
+		return eError;
+	}
+
+	DBG("Success. pipeline is created");
+
+	return eError;
+}
