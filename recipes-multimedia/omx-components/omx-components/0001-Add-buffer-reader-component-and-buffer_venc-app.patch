+static OMX_ERRORTYPE setState(buffervencData_T *ctx, OMX_U32 state)
+{
+	OMX_ERRORTYPE eError = OMX_ErrorNone;
+
+	if (ctx == NULL)
+	{
+		eError = OMX_ErrorBadParameter;
+	}
+	else
+	{
+		(void)send_command(ctx->handle_reader, OMX_CommandStateSet, state, NULL);
+		(void)send_command(ctx->handle_vidscaler, OMX_CommandStateSet, state, NULL);
+		(void)send_command(ctx->handle_videnc, OMX_CommandStateSet, state, NULL);
+		(void)send_command(ctx->handle_fakesink, OMX_CommandStateSet, state, NULL);
+		DBG("Wait for reader ");
+		(void)tsem_down(&ctx->sem_reader);
+		DBG("Wait for vidscaler ");
+		(void)tsem_down(&ctx->sem_vidscaler);
+		DBG("Wait for videnc ");
+		(void)tsem_down(&ctx->sem_videnc);
+		DBG("Wait for fakesink ");
+		(void)tsem_down(&ctx->sem_fakesink);
+	}
+
+	return eError;
+}
